{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IngestRequest": {
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "event_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "event_type": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Event Type",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "tenant_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "event_type"
        ],
        "title": "IngestRequest",
        "type": "object"
      },
      "IngestResponse": {
        "properties": {
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "status": {
            "default": "accepted",
            "title": "Status",
            "type": "string"
          },
          "stream_id": {
            "title": "Stream Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "stream_id"
        ],
        "title": "IngestResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Async event ingest edge for PulseBridge.\n\nAccepts events over HTTP, enforces per-tenant rate limits and idempotency, and\npublishes to a Redis Stream consumed by the Go worker pool.",
    "title": "PulseBridge Gateway",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness: the process is up. Never touches Redis.\n\nA liveness probe that depends on a downstream turns a brief Redis blip into a\nrestart storm, which is strictly worse than serving 503s from readiness.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness: this replica can actually accept an event right now.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/events": {
      "post": {
        "operationId": "ingest_event_v1_events_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-correlation-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Correlation-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Duplicate event id; the original was already accepted."
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Envelope failed validation."
          },
          "429": {
            "description": "Per-tenant rate limit exceeded."
          },
          "503": {
            "description": "The stream is unavailable; the event was not accepted."
          }
        },
        "summary": "Ingest Event",
        "tags": [
          "ingest"
        ]
      }
    }
  }
}
