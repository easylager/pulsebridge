# PulseBridge configuration.
#
# Every setting is read from the environment, so the same image runs on a laptop,
# in compose and in Kubernetes with no rebuild. Values shown are the defaults.
#
# Copy to .env for local overrides; .env is gitignored.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

PULSEBRIDGE_REDIS_URL=redis://localhost:6379/0
PULSEBRIDGE_STREAM_KEY=pulsebridge.events

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------

PULSEBRIDGE_SERVICE_NAME=pulsebridge-gateway
PULSEBRIDGE_LOG_LEVEL=INFO

# Run without Redis, using in-memory adapters. For local development and the
# unit suite only — nothing is durable.
PULSEBRIDGE_USE_MEMORY=false

# Per-tenant token bucket capacity, in requests per second. This bounds one
# tenant's blast radius, not total gateway capacity; see docs/benchmarks.md for
# the measured capacity of the ingest path itself.
PULSEBRIDGE_RATE_LIMIT_RPS=100

# How long a client can safely retry the same event_id and still be recognised
# as a replay rather than treated as a new event.
PULSEBRIDGE_IDEMPOTENCY_TTL_SECONDS=86400

# Approximate stream trim. Bounds Redis memory regardless of consumer health,
# and is the hard deadline during a consumer outage: past this many entries the
# oldest are discarded.
PULSEBRIDGE_STREAM_MAX_LEN=1000000

# Connection pool. Each request needs a connection for three Redis round trips,
# so this is the gateway's real concurrency limit. Raising it does not create
# Redis capacity — add gateway replicas instead.
PULSEBRIDGE_REDIS_MAX_CONNECTIONS=100
# How long a request waits for a free connection before failing. Long enough to
# absorb a burst, short enough that overload surfaces as an error rather than an
# unbounded queue.
PULSEBRIDGE_REDIS_POOL_TIMEOUT_SECONDS=2.0
PULSEBRIDGE_REDIS_SOCKET_TIMEOUT_SECONDS=2.0
PULSEBRIDGE_REDIS_CONNECT_TIMEOUT_SECONDS=2.0

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

PULSEBRIDGE_GROUP=pulsebridge-workers
# Must be unique per replica: it is how the pending list attributes stuck
# messages, and how a survivor knows whose work to reclaim. Defaults to the
# hostname, which is already unique per pod.
PULSEBRIDGE_CONSUMER=worker-1
PULSEBRIDGE_METRICS_ADDR=:9100
PULSEBRIDGE_NAMESPACE=pb

# Maximum concurrent handlers. Multiply by the replica count to get the load
# your downstream will actually see.
PULSEBRIDGE_CONCURRENCY=32

# Per-attempt deadline for one handler invocation.
PULSEBRIDGE_PROCESS_TIMEOUT=5s

# Total processing attempts before an event is dead-lettered. The count lives in
# Redis, so it survives worker restarts.
PULSEBRIDGE_MAX_ATTEMPTS=5

# How long a message must sit unacknowledged before another consumer may take it
# over. Must exceed PULSEBRIDGE_PROCESS_TIMEOUT — the worker enforces a floor of
# 2x — or every slow event gets processed twice.
PULSEBRIDGE_RECLAIM_MIN_IDLE=30s
PULSEBRIDGE_RECLAIM_INTERVAL=10s

# How often backlog gauges are refreshed.
PULSEBRIDGE_SAMPLE_INTERVAL=5s

# Dead-letter stream. Its eviction policy must not allow it to be dropped under
# memory pressure: it is the record of every event that could not be processed.
PULSEBRIDGE_DLQ_STREAM_KEY=pulsebridge.events.dlq
PULSEBRIDGE_DLQ_MAXLEN=100000

# Deduplication window for the idempotent handler. Must comfortably outlive the
# retry budget, or a claim can expire between attempts and the same event is
# applied twice.
PULSEBRIDGE_DEDUPE_TTL=24h

# Time allowed for in-flight handlers to drain on SIGTERM.
PULSEBRIDGE_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Tracing (optional)
# ---------------------------------------------------------------------------
#
# Leave unset and both services install only the W3C propagator, keeping the
# no-op tracer. Set it and one trace spans the HTTP request, the Redis write and
# the Go handler.

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=pulsebridge-gateway

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# PULSEBRIDGE_TEST_REDIS_URL=redis://localhost:6379/15
# Turn the "no Redis reachable" skip into a failure. Set in CI.
# PULSEBRIDGE_REQUIRE_REDIS=1
